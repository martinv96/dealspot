# Backend production (Render)
NODE_ENV=production
PORT=4000

# Preferred in production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME
# Optional if your provider requires SSL
DB_SSL=true

# Fallback split variables (if not using DATABASE_URL)
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Auth
JWT_SECRET=replace-with-strong-secret

# CORS
FRONTEND_URL=https://your-frontend.vercel.app
# Optional additional origins
# FRONTEND_STAGING_URL=https://staging.example.com
# CORS_ORIGINS=https://your-frontend.vercel.app,https://staging.example.com

# Mail
# Option 1 (recommended for personal email providers):
# SMTP_SERVICE=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_APP_PASSWORD_STRIP_SPACES=true

# Option 2 (manual SMTP host/port):
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_APP_PASSWORD_STRIP_SPACES=false
SMTP_SEND_TIMEOUT_MS=15000
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=45000
SMTP_FORCE_IPV4=true
ADMIN_EMAIL=
MAIL_FROM=
