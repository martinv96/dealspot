# Backend production (Render)
NODE_ENV=production
PORT=4000

# Preferred in production
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DB_NAME
# Optional if your provider requires SSL
DB_SSL=true

# Fallback split variables (if not using DATABASE_URL)
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Auth
JWT_SECRET=replace-with-strong-secret

# CORS
FRONTEND_URL=https://your-frontend.vercel.app
# Optional additional origins
# FRONTEND_STAGING_URL=https://staging.example.com
# CORS_ORIGINS=https://your-frontend.vercel.app,https://staging.example.com

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
MAIL_FROM=
# Optional SMTP send timeout in ms (0 to disable app-level timeout)
MAIL_SEND_TIMEOUT_MS=0
# Optional Nodemailer timeouts in ms
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
# Optional IP family preference: 4 (IPv4), 6 (IPv6), 0 (auto)
SMTP_FAMILY=4
