# Backend local (Render/Vercel should use dashboard env vars instead)
NODE_ENV=development
PORT=4000

# Local database (fallback mode without DATABASE_URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dealspot
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change-me-local

# CORS (comma-separated if needed)
FRONTEND_URL=http://localhost:5173
FRONTEND_STAGING_URL=http://localhost:5174
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Mail
# Option 1 (recommended for personal email providers):
# SMTP_SERVICE=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_APP_PASSWORD_STRIP_SPACES=true

# Option 2 (manual SMTP host/port):
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_APP_PASSWORD_STRIP_SPACES=false
SMTP_SEND_TIMEOUT_MS=15000
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=45000
SMTP_FORCE_IPV4=true
ADMIN_EMAIL=
MAIL_FROM=
