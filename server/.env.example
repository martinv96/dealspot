# Backend local (Render/Vercel should use dashboard env vars instead)
NODE_ENV=development
PORT=4000

# Local database (fallback mode without DATABASE_URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dealspot
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=change-me-local

# CORS (comma-separated if needed)
FRONTEND_URL=http://localhost:5173
FRONTEND_STAGING_URL=http://localhost:5174
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
MAIL_FROM=
